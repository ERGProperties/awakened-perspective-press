generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reader {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  consent        Boolean   @default(false)
  consentedAt    DateTime?
  source         String    @default("book-launch")
  sequenceStep   Int       @default(0)
  nextEmailAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
  @@index([source])
  @@index([nextEmailAt])
  @@index([unsubscribedAt])
}

model Purchase {
  id                    String    @id @default(cuid())
  stripeSessionId       String    @unique
  stripePaymentIntentId String?   @unique
  email                 String
  productName           String    @default("Understanding External Reflections — Instant eBook")
  amountPaid            Int
  currency              String    @default("usd")
  paymentStatus         String    @default("pending")
  downloadTokenHash     String?   @unique
  downloadExpiresAt     DateTime?
  emailSentAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([email])
  @@index([paymentStatus])
  @@index([createdAt])
}